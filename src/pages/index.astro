---
const bookingUrl = 'https://calendar.proton.me/bookings#b9NbJYMsuem0nfaGQyDRKRfW4XrxufM9IWHskXnp580=';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The new Memory(One) website is under construction. Get in touch or book a meeting with Alexander Watts." />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#f3f0e8" />
    <title>Memory(One) — Under construction</title>
  </head>
  <body>
    <header class="wrap">
      <a class="wordmark" href="/" aria-label="Memory One home">Memory<span>(One)</span></a>
      <span class="status"><span aria-hidden="true"></span>Work in progress</span>
    </header>
    <main id="main" class="wrap">
      <p class="eyebrow">A new chapter</p>
      <h1>Under<br />construction<span class="period">.</span></h1>
      <p class="intro">I’m working on a new home for Memory(One).<br class="desktop-break" /> In the meantime, let’s talk.</p>
      <section class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Get in touch</h2>
        <div class="contact-links">
          <a href="mailto:contact@memoryone.eu">contact@memoryone.eu</a>
          <a href="tel:+4593951496">+45 93951496</a>
        </div>
        <a class="booking" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book a meeting <span aria-hidden="true">↗</span></a>
      </section>
    </main>
    <footer class="wrap"><span>Alexander Watts</span><span>Copenhagen, Denmark</span></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-height: 100svh; display: flex; flex-direction: column; background: #f3f0e8; color: #242722; font-family: Arial, Helvetica, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .25em; }
  :global(a:focus-visible) { outline: 2px solid #3d6041; outline-offset: 7px; }
  .wrap { width: min(100% - 4rem, 1240px); margin-inline: auto; }
  header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 2rem; border-bottom: 1px solid #cccfc2; }
  .wordmark { font-size: 1.5rem; letter-spacing: -.06em; font-weight: 700; text-decoration: none; }
  .wordmark span { font-weight: 400; }
  .status { display: flex; align-items: center; gap: .6rem; font-size: .75rem; }
  .status > span { width: .5rem; height: .5rem; border-radius: 50%; background: #526b40; }
  main { flex: 1; padding-block: clamp(3rem, 8vh, 7rem); }
  .eyebrow, h2 { font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 400; }
  .eyebrow { margin: 0 0 2rem; }
  h1 { font-size: clamp(2.65rem, 8.8vw, 8.25rem); line-height: .94; letter-spacing: -.075em; font-weight: 400; margin: 0 0 2rem; }
  .period { color: #526b40; }
  .intro { font-size: clamp(1rem, 1.8vw, 1.3rem); line-height: 1.65; color: #5d6257; margin: 0; }
  .contact { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 1.5rem 2rem; margin-top: clamp(2.5rem, 7vh, 5rem); }
  h2 { grid-column: 1 / -1; margin: 0; }
  .contact-links { display: flex; gap: 1rem 2.5rem; flex-wrap: wrap; font-size: clamp(1rem, 1.6vw, 1.2rem); }
  .booking { display: inline-flex; align-items: center; justify-content: space-between; gap: 3rem; padding: 1rem 1.4rem; background: #242722; color: #f3f0e8; text-decoration: none; font-size: .9rem; transition: background .15s; }
  .booking:hover { background: #3d6041; }
  footer { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid #cccfc2; padding-block: 1.4rem; color: #5d6257; font-size: .75rem; }
  @media (max-width: 600px) {
    .wrap { width: calc(100% - 2rem); }
    header { padding-block: 1.4rem; }
    .wordmark { font-size: 1.25rem; }
    .status { font-size: .65rem; }
    .contact { grid-template-columns: 1fr; }
    .contact-links { flex-direction: column; gap: 1rem; }
    .booking { justify-self: start; margin-top: .5rem; }
    .desktop-break { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .booking { transition: none; } }
</style>
