---
const bookingUrl = 'https://calendar.proton.me/bookings#b9NbJYMsuem0nfaGQyDRKRfW4XrxufM9IWHskXnp580=';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The new Memory(One) website is under construction. Get in touch or book a meeting with Alexander Watts." />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#012138" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="preload" href="/fonts/FKGrotesk-Medium.otf" as="font" type="font/otf" crossorigin />
    <title>Memory(One) — Under construction</title>
  </head>
  <body>
    <header class="wrap">
      <a class="wordmark" href="/" aria-label="Memory One home">
        <img src="/brand/memory-one-logo-on-dark.webp" alt="Memory(One)" width="2001" height="601" fetchpriority="high" />
      </a>
    </header>
    <main id="main" class="wrap">
      <h1 data-scramble aria-label="Under construction.">Under<br />construction<span class="period">.</span></h1>
      <p class="intro" data-scramble>I’m working on a new home for Memory(One).<br class="desktop-break" /> In the meantime, let’s talk.</p>
      <section class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Get in touch</h2>
        <div class="contact-links">
          <a href="mailto:contact@memoryone.eu">contact@memoryone.eu</a>
          <a href="tel:+4593951496">+45 93951496</a>
        </div>
        <a class="booking" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book a meeting <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17 17 7M7 7h10v10" stroke="currentColor" stroke-width="1.5" /></svg></a>
      </section>
    </main>
    <footer class="wrap"><span>Alexander Watts</span><span>Copenhagen, Denmark</span></footer>
  </body>
</html>

<script>
  import '../lib/text-scramble';
</script>

<style>
  @font-face { font-family: 'FK Grotesk'; src: url('/fonts/FKGrotesk-Regular.otf') format('opentype'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'FK Grotesk'; src: url('/fonts/FKGrotesk-Medium.otf') format('opentype'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'FK Grotesk Mono'; src: url('/fonts/FKGroteskMono-Medium.otf') format('opentype'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'FK Grotesk SemiMono'; src: url('/fonts/FKGroteskSemiMono-Medium.otf') format('opentype'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'FK Grotesk Neue'; src: url('/fonts/FKGroteskNeue-Light.otf') format('opentype'); font-weight: 300; font-style: normal; font-display: swap; }
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-height: 100svh; display: flex; flex-direction: column; background: #012138; color: #CFCFC5; font-family: 'FK Grotesk', Arial, sans-serif; font-weight: 400; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .25em; }
  :global(a:focus-visible) { outline: 2px solid #008580; outline-offset: 7px; }
  .wrap { width: min(100% - 4rem, 1240px); margin-inline: auto; }
  header { display: flex; align-items: center; padding-block: 1.25rem; }
  .wordmark { display: block; position: relative; width: 212px; max-width: 100%; aspect-ratio: 1514 / 300; overflow: hidden; }
  /* Clip the original asset’s transparent margins so its artwork aligns with the text. */
  .wordmark img { display: block; position: absolute; width: 132.1664%; max-width: none; height: auto; left: -15.6539%; top: -50%; }
  main { flex: 1; padding-block: clamp(3rem, 8vh, 7rem); }
  h2 { font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 500; font-family: 'FK Grotesk Mono', monospace; }
  h1 { font-size: clamp(2.65rem, 8.8vw, 8.25rem); line-height: .94; letter-spacing: -.055em; font-weight: 500; margin: 0 0 2rem; }
  .period { color: #FF7F00; }
  .intro { font-size: clamp(1rem, 1.8vw, 1.3rem); line-height: 1.65; color: #CFCFC5; margin: 0; }
  :global(.scramble-line) { cursor: crosshair; }
  :global(.scramble-char) { position: relative; }
  :global(.scramble-glyph) { position: absolute; inset: 0; text-align: center; pointer-events: none; }
  :global(.scramble-detail) { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); height: 1px; font-family: 'FK Grotesk Mono', monospace; font-size: 11px; font-weight: 500; letter-spacing: 0; line-height: 1; white-space: nowrap; pointer-events: none; }
  .contact { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 1.5rem 2rem; margin-top: clamp(2.5rem, 7vh, 5rem); }
  h2 { grid-column: 1 / -1; margin: 0; }
  .contact-links { display: flex; gap: 1rem 2.5rem; flex-wrap: wrap; font-family: 'FK Grotesk Mono', monospace; font-weight: 500; font-size: clamp(1rem, 1.6vw, 1.2rem); }
  .booking { display: inline-flex; align-items: center; justify-content: space-between; gap: 3rem; padding: 1rem 1.4rem; background: #FF7F00; color: #CFCFC5; text-decoration: none; font-family: 'FK Grotesk Neue', Arial, sans-serif; font-weight: 300; font-size: 1rem; transition: background .15s; }
  .booking:hover { text-decoration: underline; text-underline-offset: .25em; }
  footer { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-block: 1.4rem; color: #CFCFC5; font-family: 'FK Grotesk SemiMono', monospace; font-weight: 500; font-size: .75rem; }
  @media (max-width: 600px) {
    .wrap { width: calc(100% - 2rem); }
    header { padding-block: 1.4rem; }
    .wordmark { width: 182px; }
    .contact { grid-template-columns: 1fr; }
    .contact-links { flex-direction: column; gap: 1rem; }
    .booking { justify-self: start; margin-top: .5rem; }
    .desktop-break { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .booking { transition: none; } }
</style>
