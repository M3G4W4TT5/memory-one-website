---
import ConstructionThought from '../components/ConstructionThought';
import Noise from '../components/Noise';
const thoughtSteps = ['Searching our services', 'Drafting an answer', 'Web Design & UX', 'Web Development', 'Branding & Visual Identity', 'Software Development', 'Agentic AI', 'System Integration', 'AI Search Optimisation', 'SEO', 'Managed Operations', 'Consulting', 'Finish building website ...'];
const bookingUrl = 'https://calendar.proton.me/bookings#b9NbJYMsuem0nfaGQyDRKRfW4XrxufM9IWHskXnp580=';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The new Memory(One) website is under construction. Get in touch or book a meeting with Alexander Watts." />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="preload" href="/fonts/FKGrotesk-Medium.otf" as="font" type="font/otf" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('is-loading');
      // Fail open if the page scripts cannot load.
      window.setTimeout(() => {
        document.documentElement.classList.remove('is-loading', 'is-revealing');
        document.querySelectorAll('[inert]').forEach(el => { el.inert = false; });
        document.querySelector('main')?.removeAttribute('aria-busy');
      }, 10000);
    </script>
    <title>Memory(One) — Under construction</title>
  </head>
  <body>
    <div class="pixel-background" data-pixel-blast aria-hidden="true"></div>
    <Noise client:load patternSize={290} patternScaleX={1} patternScaleY={1} patternRefreshInterval={2} patternAlpha={10} />
    <div class="page-loader" role="status" aria-label="Loading page">
      <video class="loading-logo" width="1200" height="640" muted playsinline preload="auto" poster="/brand/memory-one-loading-poster.webp" aria-hidden="true">
        <source src="/brand/memory-one-loading.webm" type="video/webm" />
      </video>
    </div>
    <div class="page-view">
    <main id="main" class="wrap">
      <div class="construction-copy">
      <h1 data-scramble aria-label="Under construction.">Under<br />construction<span class="period">.</span></h1>
      <p class="intro" data-scramble>I’m working on a new home for Memory(One).<br class="desktop-break" /> In the meantime, let’s talk.</p>
      <section class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Get in touch</h2>
        <div class="contact-links">
          <a href="mailto:contact@memoryone.eu">contact@memoryone.eu</a>
          <a href="tel:+4593951496">+45 93951496</a>
          <a href={bookingUrl} target="_blank" rel="noopener noreferrer">book a meeting</a>
        </div>
      </section>
      <aside class="construction-thought" aria-label="Building the website">
        <ConstructionThought client:load steps={thoughtSteps} />
      </aside>
      </div>
    </main>
    </div>
    <a class="github-button" href="https://github.com/M3G4W4TT5" target="_blank" rel="noopener noreferrer" aria-label="Visit my GitHub profile">
      <span class="svg-container"><svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24" width="26" height="26"><path d="M12 .297C5.37 .297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.087-.744.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.303-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23A11.52 11.52 0 0 1 12 6.292c1.02.005 2.047.138 3.006.404 2.291-1.553 3.297-1.23 3.297-1.23.653 1.652.242 2.873.118 3.176.769.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.625-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg></span>
      <span class="github-bg" aria-hidden="true"></span>
    </a>
  </body>
</html>

<script>
  import '../lib/text-scramble';
  import { revealWhenReady } from '../lib/page-reveal';
  revealWhenReady(import('../lib/pixel-blast'));
</script>

<style>
  @font-face { font-family: 'FK Grotesk'; src: url('/fonts/FKGrotesk-Regular.otf') format('opentype'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'FK Grotesk'; src: url('/fonts/FKGrotesk-Medium.otf') format('opentype'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'FK Grotesk Neue'; src: url('/fonts/FKGroteskNeue-Thin.otf') format('opentype'); font-weight: 100; font-style: normal; font-display: swap; }
  @font-face { font-family: 'FK Grotesk Mono'; src: url('/fonts/FKGroteskMono-Medium.otf') format('opentype'); font-weight: 500; font-style: normal; font-display: swap; }
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-height: 100svh; display: flex; flex-direction: column; background: #000000; color: #CFCFC5; font-family: 'FK Grotesk', Arial, sans-serif; font-weight: 400; font-synthesis: none; -webkit-font-smoothing: antialiased; isolation: isolate; }
  .pixel-background { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; filter: brightness(1.6); }
  :global(.pixel-background canvas) { display: block; width: 100%; height: 100%; }
  :global(a) { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .25em; }
  :global(a:focus-visible) { outline: 2px solid #008580; outline-offset: 7px; }
  .wrap { width: min(100% - 4rem, 1240px); margin-inline: auto; }
  main { margin-block: auto; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: 3rem; min-height: clamp(380px, 65svh, 640px); }
  .construction-copy { position: relative; }
  .construction-thought { position: absolute; top: 0; left: calc(100% + 3rem + (100% / 1.15 - 320px) / 2); width: 320px; }
  h2 { font-size: .7rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 500; font-family: 'FK Grotesk Mono', monospace; }
  h1 { font-size: clamp(2.65rem, 6.2vw, 5.6rem); line-height: .94; letter-spacing: -.055em; font-weight: 500; margin: 0 0 2rem; }
  .period { color: #FF7F00; }
  .intro { font-size: clamp(1rem, 1.8vw, 1.3rem); line-height: 1.65; color: #CFCFC5; margin: 0; }
  :global(.scramble-line) { cursor: crosshair; }
  :global(.scramble-char) { position: relative; }
  :global(.scramble-glyph) { position: absolute; inset: 0; text-align: center; pointer-events: none; }
  :global(.scramble-detail) { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); height: 1px; font-family: 'FK Grotesk Mono', monospace; font-size: 11px; font-weight: 500; letter-spacing: 0; line-height: 1; white-space: nowrap; pointer-events: none; }
  .contact { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-top: clamp(2.5rem, 7vh, 5rem); }
  h2 { grid-column: 1 / -1; margin: 0; }
  .contact-links { display: flex; gap: 1rem 2.5rem; flex-wrap: nowrap; white-space: nowrap; font-family: 'FK Grotesk Mono', monospace; font-weight: 500; font-size: clamp(1rem, 1.6vw, 1.2rem); }
  .contact-links a:hover { color: #FF7F00; }
  .page-view { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: 4rem; }
  :global(.is-loading) .page-view, :global(.is-loading) .github-button { pointer-events: none; }
  .page-loader { display: none; position: fixed; inset: 0; z-index: 10; place-items: center; background: #000000; opacity: 1; transition: opacity 1s ease; }
  :global(.is-loading) .page-loader, :global(.is-revealing) .page-loader { display: grid; }
  :global(.is-revealing) .page-loader { opacity: 0; pointer-events: none; }
  .loading-logo { display: block; width: min(45vw, 720px); height: auto; max-height: 50svh; object-fit: contain; }
  .github-button { position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 2; width: 45px; height: 45px; display: flex; align-items: center; justify-content: center; border: none; border-radius: 7px; isolation: isolate; background: transparent; color: #CFCFC5; }
  .svg-container { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border: 1px solid rgb(156 156 156 / .466); border-radius: 10px; background: transparent; backdrop-filter: blur(0); transition: background-color .3s, backdrop-filter .3s; }
  .github-bg { position: absolute; inset: 0; z-index: -1; border-radius: 10px; background: #FF7F00; pointer-events: none; transition: transform .3s; }
  .github-button:hover .github-bg { transform: rotate(35deg); transform-origin: bottom; }
  .github-button:hover .svg-container { background: rgb(156 156 156 / .466); backdrop-filter: blur(4px); }
  @media (max-width: 900px) {
    main { grid-template-columns: 1fr; gap: 3rem; min-height: 0; margin-block: 0; }
    .construction-thought { position: static; width: max-content; max-width: 100%; margin: 3rem auto 0; }
    .page-view { justify-content: flex-start; }
  }
  @media (max-width: 600px) {
    .loading-logo { width: 82vw; }
    .wrap { width: calc(100% - 2rem); }
    .contact { grid-template-columns: 1fr; }
    .contact-links { flex-direction: column; gap: 1rem; }
    .desktop-break { display: none; }
  }
</style>
